{
 "dur": 96.393,
 "lines": [
  {
   "id": "L01",
   "show": "Jangan beli BMW M, sebelum tengok video ni!",
   "start": 0.0,
   "end": 2.96
  },
  {
   "id": "L02",
   "show": "Sebab bukan semua yang ada huruf M, tu M betul.",
   "start": 3.07,
   "end": 6.04
  },
  {
   "id": "L03",
   "show": "Hai geng! Kemal dari ECW Motorsport. Jom decode badge M, satu-satu.",
   "start": 6.28,
   "end": 11.079
  },
  {
   "id": "L04",
   "show": "M ni maksudnya Motorsport. Divisyen lumba BMW.",
   "start": 11.319,
   "end": 14.512
  },
  {
   "id": "L05",
   "show": "M penuh? Senang je. Huruf M, campur satu nombor.",
   "start": 14.622,
   "end": 18.017
  },
  {
   "id": "L06",
   "show": "Makin besar nombor, makin besar kereta.",
   "start": 18.127,
   "end": 20.482
  },
  {
   "id": "L07",
   "show": "M2, coupe kecil. Paling fun.",
   "start": 20.722,
   "end": 23.102
  },
  {
   "id": "L08",
   "show": "M3, sedan empat pintu.",
   "start": 23.212,
   "end": 25.02
  },
  {
   "id": "L09",
   "show": "M3 pun ada Touring. Wagon M3 pertama dalam sejarah!",
   "start": 25.13,
   "end": 28.538
  },
  {
   "id": "L10",
   "show": "M4 pula, M3 dua pintu. Coupe atau convertible.",
   "start": 28.778,
   "end": 32.527
  },
  {
   "id": "L11",
   "show": "M5, sedan besar. Sekarang plug-in hybrid.",
   "start": 32.637,
   "end": 35.433
  },
  {
   "id": "L12",
   "show": "Tambah X, jadi SUV. Macam X5 M, X6 M.",
   "start": 35.543,
   "end": 39.841
  },
  {
   "id": "L13",
   "show": "XM pula, model pertama yang lahir sebagai M sahaja, sejak M1.",
   "start": 39.951,
   "end": 44.302
  },
  {
   "id": "L14",
   "show": "Badge belakang pula. Ada Competition? Power lebih.",
   "start": 44.542,
   "end": 47.497
  },
  {
   "id": "L15",
   "show": "CS pula, Club Sport. Lagi ringan, lagi laju.",
   "start": 47.607,
   "end": 50.877
  },
  {
   "id": "L16",
   "show": "CSL tambah Leichtbau, Jerman untuk ringan. M4 CSL, seribu unit je.",
   "start": 50.987,
   "end": 56.554
  },
  {
   "id": "L17",
   "show": "Turun satu level, M Performance.",
   "start": 56.794,
   "end": 58.7
  },
  {
   "id": "L18",
   "show": "M duduk depan nombor. Macam M340i, M135.",
   "start": 58.81,
   "end": 63.251
  },
  {
   "id": "L19",
   "show": "Laju dari BMW biasa, tapi bukan M penuh.",
   "start": 63.361,
   "end": 66.452
  },
  {
   "id": "L20",
   "show": "Haa, yang paling ramai keliru. M Sport.",
   "start": 66.692,
   "end": 69.187
  },
  {
   "id": "L21",
   "show": "Cuma trim. Rim besar, bumper sporty, power tak tambah langsung.",
   "start": 69.297,
   "end": 73.187
  },
  {
   "id": "L22",
   "show": "Contoh, 330e M Sport. Enjin tetap 330e.",
   "start": 73.297,
   "end": 77.085
  },
  {
   "id": "L23",
   "show": "Satu lagi, badge M ni orang boleh pasang sendiri. Jadi check spec dan dokumen, bukan badge je.",
   "start": 77.195,
   "end": 82.819
  },
  {
   "id": "L24",
   "show": "Jadi, M4 Competition xDrive? M penuh, power lebih, pacuan empat roda.",
   "start": 83.059,
   "end": 87.876
  },
  {
   "id": "L25",
   "show": "Nak BMW yang berbaloi? Jumpa ECW Motorsport.",
   "start": 88.116,
   "end": 91.822
  },
  {
   "id": "L26",
   "show": "Follow ECW Motorsport untuk tips kereta lagi. Jumpa lagi, geng!",
   "start": 91.932,
   "end": 96.283
  }
 ],
