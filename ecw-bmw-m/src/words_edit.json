{
 "dur": 63.815,
 "lines": [
  {
   "id": "L01",
   "show": "Jangan beli BMW M, sebelum tengok video ni!",
   "start": 0.0,
   "end": 2.871
  },
  {
   "id": "L02",
   "show": "Sebab bukan semua yang ada huruf M, tu M betul.",
   "start": 2.961,
   "end": 5.872
  },
  {
   "id": "L03",
   "show": "M maksudnya Motorsport, divisyen lumba BMW.",
   "start": 6.072,
   "end": 8.924
  },
  {
   "id": "L04",
   "show": "M penuh? Huruf M, campur satu nombor.",
   "start": 9.014,
   "end": 11.456
  },
  {
   "id": "L05",
   "show": "Makin besar nombor, makin besar kereta.",
   "start": 11.546,
   "end": 13.863
  },
  {
   "id": "L06",
   "show": "M2, coupe kecil.",
   "start": 14.063,
   "end": 15.618
  },
  {
   "id": "L07",
   "show": "M3, sedan.",
   "start": 15.708,
   "end": 16.959
  },
  {
   "id": "L08",
   "show": "M4, M3 dua pintu. Coupe atau convertible.",
   "start": 17.049,
   "end": 20.374
  },
  {
   "id": "L09",
   "show": "M5, sedan besar. Sekarang plug-in hybrid.",
   "start": 20.464,
   "end": 23.132
  },
  {
   "id": "L10",
   "show": "Tambah X, jadi SUV. Macam X5 M.",
   "start": 23.332,
   "end": 26.846
  },
  {
   "id": "L11",
   "show": "XM pula, memang lahir sebagai M sahaja.",
   "start": 26.936,
   "end": 29.546
  },
  {
   "id": "L12",
   "show": "Ada Competition? Power lebih.",
   "start": 29.746,
   "end": 31.473
  },
  {
   "id": "L13",
   "show": "CS, Club Sport. Lagi ringan, lagi laju.",
   "start": 31.563,
   "end": 34.429
  },
  {
   "id": "L14",
   "show": "CSL tambah Leichtbau. Jerman, maksudnya ringan.",
   "start": 34.519,
   "end": 37.937
  },
  {
   "id": "L15",
   "show": "Turun satu level, M Performance.",
   "start": 38.137,
   "end": 40.013
  },
  {
   "id": "L16",
   "show": "M duduk depan nombor. Macam M340i, M135.",
   "start": 40.103,
   "end": 44.388
  },
  {
   "id": "L17",
   "show": "Laju dari BMW biasa, tapi bukan M penuh.",
   "start": 44.478,
   "end": 47.497
  },
  {
   "id": "L18",
   "show": "Yang paling ramai keliru, M Sport.",
   "start": 47.697,
   "end": 49.648
  },
  {
   "id": "L19",
   "show": "Cuma trim. Rim besar, bumper sporty, power tak tambah langsung.",
   "start": 49.738,
   "end": 53.412
  },
  {
   "id": "L20",
   "show": "Jadi M4 Competition xDrive? M penuh, power lebih, pacuan empat roda.",
   "start": 53.612,
   "end": 58.051
  },
  {
   "id": "L21",
   "show": "Nak BMW yang berbaloi? Jumpa ECW Motorsports.",
   "start": 58.251,
   "end": 62.081
  },
  {
   "id": "L22",
   "show": "Follow untuk tips kereta lagi!",
   "start": 62.171,
   "end": 63.725
  }
 ],
